{
  "name": "guitar-academy",
  "version": "1.0.0",
  "private": true,
  "description": "أكاديمية الجيتار: السلالم والمقامات من المبتدئ إلى الاحتراف",
  "scripts": {
    "serve": "python3 -m http.server 8080 --directory www",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "voice": "node tools/voice-list.mjs voice-list.json && python3 tools/gen_voice.py voice-list.json www/audio/voice"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  },
  "type": "module"
}
